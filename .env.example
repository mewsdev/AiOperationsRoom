# Copie para .env e ajuste. Linux: rode `id -u` e `id -g` para descobrir os valores.
AIOR_UID=1000
AIOR_GID=1000
AIOR_PORT=8765

# Pasta de dados compartilhada com o hook do Claude Code (padrão: ~/.ai-operations-room).
# Prefira caminhos absolutos: com `sudo docker compose`, ~ vira /root.
# No Windows, use o caminho completo, por exemplo C:/Users/voce/.ai-operations-room
# AIOR_DATA_DIR=/home/voce/.ai-operations-room

# Registro de sessões do Claude Code (padrão: ~/.claude/sessions). Usado só com docker-compose.linux.yml.
# AIOR_SESSIONS_DIR=/home/voce/.claude/sessions
